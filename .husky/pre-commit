echo "--------------------------------------------------"
echo "🐶 [Husky] Starting pre-commit checks..."
echo "--------------------------------------------------"

format_staged_files() {
	git diff --cached --name-only --diff-filter=ACMR -z -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.md' |
		xargs -0 -r pnpm exec prettier "$@"
}

stage_formatted_files() {
	git diff --cached --name-only --diff-filter=ACMR -z -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.md' |
		xargs -0 -r git add --
}

# 1. Prettier check + auto-fix
echo "🔍 [1/4] Checking formatting (Prettier)..."
if ! format_staged_files --check; then
	echo "⚠️  Prettier found issues. Auto-formatting..."
	format_staged_files --write || exit 1
	stage_formatted_files
	echo "✅ Files reformatted and re-staged automatically."
fi

# 2. ESLint check
echo "🔍 [2/4] Checking linting (ESLint)..."
pnpm run lint || {
	echo "❌ [Error] ESLint check failed. Please fix the issues above."
	exit 1
}

# 3. TypeScript check
echo "🔍 [3/4] Checking types (TypeScript)..."
pnpm run check-types || {
	echo "❌ [Error] TypeScript check failed. Please fix the type errors above."
	exit 1
}

# 4. Build check
echo "⚙️  [4/4] Running build..."
pnpm run build || {
	echo "❌ [Error] Build failed. Check the logs for details."
	exit 1
}

echo "------------------------------------------------------"
echo "✅ [Husky] All checks passed! Proceeding to commit 🚀"
echo "------------------------------------------------------"
